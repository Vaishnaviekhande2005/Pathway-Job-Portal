PORT=5000
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/pathway_job_portal?retryWrites=true&w=majority&appName=Cluster0
# Optional custom DNS resolvers for environments that cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5174
ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-use
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=Pathway <no-reply@example.com>
# Optional persistent volume path for uploaded resumes in production.
RESUME_UPLOAD_DIR=